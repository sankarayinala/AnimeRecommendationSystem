data_ingestion:
  bucket_name: "san-mlops-project-2"
  bucket_file_names:
    - "animelist.csv"
    - "anime.csv"
    - "anime_with_synopsis.csv"
  gcp_credentials_env: GCP_SERVICE_ACCOUNT_JSON
  train_ratio: 0.8
  min_ratings_per_user: 400
  test_size: 1000
  truncate_animelist: false
  animelist_limit: 500000

comet_ml:
  api_key_env: COMET_API_KEY
  project_name: "mlops-course-2"
  workspace: "sankar-bmc"
  experiment_name: "anime-recommender-v2"
  enabled: true